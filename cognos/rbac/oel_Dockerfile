# Use the official Oracle Linux slim image as the base
FROM oraclelinux:10-slim

# Required to install nodejs package
RUN sed -i -e 's/gpgcheck=1/gpgcheck=1\nsslverify=0/g' /etc/yum.repos.d/oracle-linux-ol10.repo

# Install Node.js 22 from the Oracle Linux repository
# Copy your certificate file into the CA certificates directory
RUN microdnf install -y nodejs ca-certificates && \
    microdnf clean all

# Copy host CA certs into the container
COPY tls-ca-bundle.pem /etc/pki/ca-trust/source/anchors/custom-ca-bundle.crt

# Update the container’s trust store
RUN update-ca-trust extract

# Configure npm AND Node.js to use the CA bundle
ENV NODE_EXTRA_CA_CERTS=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
ENV SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
ENV REQUESTS_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Configure npm to use cert
# Install PM2 globally and other utilities
# sonar.issue.ignore.block
RUN npm config set cafile ${NODE_EXTRA_CA_CERTS} && \
    npm config set strict-ssl true && \
    npm install -g pm2 serve --ignore-scripts && \
    microdnf install -y curl procps && \
    microdnf clean all

# Set working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /app/core/bin \
             /app/core/etc \
             /app/core/lib \
             /app/core/logs \
             /app/core/data \
             /var/lib/bv/rbac

# Copy the entire core directory structure
COPY core/ /app/core/

# Set executable permissions for binaries
RUN chmod +x /app/core/bin/rbac-service/rbac-module 2>/dev/null || true && \
    chmod +x /app/core/lib/licensing 2>/dev/null || true

# Copy PM2 ecosystem file (for reference/manual management)
COPY ecosystem.config.js /app/

# Copy environment configuration script
COPY docker-env-setup.sh /app/
RUN chmod +x /app/docker-env-setup.sh

# Expose necessary ports (default values, can be overridden)
EXPOSE 6720 6721

# Set working directory back to /app
WORKDIR /app

# Run environment setup script which will:
# 1. Configure all settings from docker-config.env
# 2. Build frontend
# 3. Start all PM2 services (RBAC-CLIENT, RBAC-EXE, licensing)
# 4. Keep container running with PM2 in foreground
CMD ["/bin/bash", "-c", "/app/docker-env-setup.sh && exec pm2 logs"]
