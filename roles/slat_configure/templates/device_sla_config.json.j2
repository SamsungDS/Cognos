[
  {# 
  "The configuration file device_sla_config.json is used to determine the latency and other
attributes of the devices. Once the CXL feature library supports, this will be removed" 
  #}
  {
    "type": "FM_DIRECT_CMMD",
    "Devices": [
      {% if slat_configure_nodes_info | length >1 -%}
      {%- for item in slat_configure_nodes_info %}{
        "dev_name": "DEV{{item}}-256G",
        "node_name": "{{ slat_configure_controller_ip }}",
        "dev_size": "{{ slat_configure_numa_info.stdout.splitlines() | map('regex_search', 'node '+item+' free: (\\d+) MB', '\\1')| reject('equalto', None) |first |first |int *1024*1024 }}",
        "dev_numa": {{item}},
        "sla_avg_latency_ns": 100
      }{% if loop.last != True  -%},{%- endif -%}

      {%- endfor -%}
      {%- endif -%}
    ]
  },
  {
    "type": "FM_DIRECT_CMMH",
    "Devices": [
    ]
  },
  {
    "type": "FM_REMOTE_CMMB",
    "Devices": [
    ]
  }
]
