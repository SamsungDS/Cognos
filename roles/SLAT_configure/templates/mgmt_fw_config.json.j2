{
  "svk_mgmt_fw_node":
      {
        "framework": {
          "lib_path": "/usr/local/svk/core/lib64/libsvkframework.so",
          "conf_file": "/etc/svk/mgmt_fw_config.json"
        },
        "cluster": {
          "id": "CL_ID_1"
        },
        "controller": {
          "id": "{{ controller_ip }}",
          "port": 9999
        },
        "node": {
          "name": "node_1",
          "id": "{{ node_ip }}",
          "port": 9998
        },
        "logger": {
          "log_level": "INFO",
          "log_file_name": "/var/log/svk/svk_mgmt_fw_node.log",
          "log_file_count": 10,
          "log_file_size": 1048576,
          "sink_type": "rotating_file"
        }
      },
  "svk_mgmt_fw_controller":
      {
        "controller": {
          "id": "{{ controller_ip }}",
          "port": 9999
        },
        "logger": {
          "log_level": "INFO",
          "log_file_name": "/var/log/svk/svk_mgmt_fw_controller.log",
          "log_file_count": 10,
          "log_file_size": 1048576,
          "sink_type": "rotating_file"
        }
      },
  "svk_mgmt_rest_api":
      {
        "controller": {
          "id": "{{ controller_ip }}",
          "port": "9999"
        },
        "rest_server": {
          "id": "{{ rest_ip }}",
          "port": "8001"
        },
        "logger": {
          "log_file_name": "/var/log/svk/svk_mgmt_rest_api.log"
        }
      },
  "core":
      {
        "_comment": "All the feature libraries (ONLY) should be present in /usr/local/svk/feature_modules",
        "feat_modules_dir": "{{ feat_modules_bin_dir }}",
        "logger": {
          "log_level": "INFO",
          "log_file_name": "/var/log/svk/framework.log",
          "log_file_count": 1,
          "log_file_size": 1048576,
          "sink_type": "rotating_file"
        }

      },
  "svk_mgmt_fw_svc_mgr":
      {
        "svc_mgr": {
          "feat_sm_svcs_dir": "/usr/local/svk/svc_mgr_libs/"
        },
        "logger": {
          "log_level": "INFO",
          "log_file_name": "/var/log/svk/svk_mgmt_fw_svc_mgr.log",
          "log_file_count": 10,
          "log_file_size": 1048576,
          "sink_type": "rotating_file"
        }
      }
}
