def create_table():
    try:
        # Connect to MySQL server
        sql = '''
        CREATE TABLE IF NOT EXISTS {} (
                    `index` INTEGER UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
                    `date` DATETIME,
                    `host` VARCHAR(45),
                    `is_svk` VARCHAR(10) NOT NULL,
                    `dram_num` SMALLINT UNSIGNED,
                    `dram_total_capacity_GB` INTEGER UNSIGNED,
                    `cxl_num` SMALLINT UNSIGNED,
                    `cxl_total_capacity_GB` INTEGER UNSIGNED,
                    `gemfire_num` SMALLINT UNSIGNED,
                    `redundancy` SMALLINT UNSIGNED,
                    `dram_cxl_cxl_ratio` VARCHAR(20),
                    `wokload_data_size` VARCHAR(20),
                    `workload_iterations` INTEGER UNSIGNED,
                    `concurrency` VARCHAR(10),
                    `mem_type` VARCHAR(20),
                    `rec_count_m` INTEGER UNSIGNED,
                    `ops_count_m` INTEGER UNSIGNED,
                    `total_runtime_min` INTEGER UNSIGNED,
                    `throughput_ops_per_sec` FLOAT,
                    `read_avg_us` INTEGER UNSIGNED,
                    `read_p99_us` INTEGER UNSIGNED,
                    `update_avg_us` INTEGER UNSIGNED,
                    `update_p99_us` INTEGER UNSIGNED
                ) ENGINE=InnoDB DEFAULT CHARSET=utf8;
        '''.format(ycsb_overall_tab)
        record_every_round_sql = '''
        CREATE TABLE IF NOT EXISTS {} (
                    `id` INTEGER UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
                    `iteration` SMALLINT UNSIGNED,
                    `runtime_min` INTEGER UNSIGNED,
                    `throughput_ops_per_sec` FLOAT,
                    `read_avg_us` INTEGER UNSIGNED,
                    `read_p99_us` INTEGER UNSIGNED,
                    `update_avg_us` INTEGER UNSIGNED,
                    `update_p99_us` INTEGER UNSIGNED,
                    `overall_index` INTEGER UNSIGNED,
                    FOREIGN KEY (`overall_index`) REFERENCES {}(`index`)
                ) 
        '''.format(ycsb_eachround_tab, ycsb_overall_tab)

        record_10round_sql = '''
        CREATE TABLE IF NOT EXISTS {} (
                    `id` INTEGER UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
                    `iteration` SMALLINT UNSIGNED,
                    `runtime_min` INTEGER UNSIGNED,
                    `throughput_ops_per_sec` FLOAT,
                    `read_avg_us` INTEGER UNSIGNED,
                    `read_p99_us` INTEGER UNSIGNED,
                    `update_avg_us` INTEGER UNSIGNED,
                    `update_p99_us` INTEGER UNSIGNED,
                    `overall_index` INTEGER UNSIGNED,
                    FOREIGN KEY (`overall_index`) REFERENCES {}(`index`)
                ) 
        '''.format(ycsb_10round_tab, ycsb_overall_tab)

        record_overall_info_sql = '''
        CREATE TABLE IF NOT EXISTS {} (
                    `id` INTEGER UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
                    `cpu_usage` DECIMAL(5,2),
                    `power_consumption` FLOAT,
                    `jira_id` VARCHAR(20),
                    `timeout_setting` VARCHAR(20),
                    `svk_applied_size` VARCHAR(20),
                    `comment` VARCHAR(100),
                    `load_type` VARCHAR(20),
                    `overall_index` INTEGER UNSIGNED,
                    FOREIGN KEY (`overall_index`) REFERENCES {}(`index`)
                ) 
        '''.format(ycsb_overall_sup_tab, ycsb_overall_tab)

        connection = pymysql.connect(**DB_CONFIG)
        with connection.cursor() as cursor:
            # Create table
            cursor.execute(sql)
            connection.commit()
            cursor.execute(record_every_round_sql)
            connection.commit()
            cursor.execute(record_10round_sql)
            connection.commit()
            cursor.execute(record_overall_info_sql)
            connection.commit()
            print("Table created successfully.")
    except pymysql.MySQLError as e:
        print(f"Error while creating table: {e}")
    finally:
        connection.close()

def find_files_with_keyword(directory, keyword):
    ret = None
    for root, dirs, files in os.walk(directory):
        for file in files:
            file_path = os.path.join(root, file)
            if keyword not in file:
                continue
            try:
                file_size = os.path.getsize(file_path)
                if file_size == 0:
                    continue  # SKIP empty file
            except (OSError, FileNotFoundError):
                continue

            # Find the first file, and return filename
            ret = file
            return ret
    return ret  # Return None


def get_host_mem_info(file_path):
    if not os.path.exists(file_path):
        print("File does not exist.")
        return None
    file = open(file_path, "r")
    cxl_num = 0
    cxl_capacity =0
    dram_num =0 
    dram_capacity = 0
    cxl_id=[]
    dram_id=[]
    num_end_pattern = re.compile(r".*[0-9]$")
    size_pattern = re.compile(r"node (\d+) size: (\d+) MB")
    cxl_node_pattern = re.compile(r"node (\d+) cpus:$")
    for line in file.readlines():
        if cxl_node_pattern.match(line):
            cxl_num+=1
            cxl_id.append(re.findall("\d+", line)[0])
        elif "cpus:" in line and num_end_pattern.match(line):
            dram_num +=1
            dram_id.append(re.findall("\d+", line)[0])
        else:
            match = re.match(size_pattern, line)
            if match:
                groups = match.groups()
                if groups[0] in cxl_id:
                    cxl_capacity += int(groups[1])/1024
                elif groups[0] in dram_id:
                    dram_capacity += int(groups[1])/1024
    file.close()
    return cxl_num,cxl_capacity,dram_capacity,dram_num

def caculate_runtime(start_date,end_date):
    start_time = time.strptime(start_date,"%Y/%m/%d %H:%M:%S")
    end_time = time.strptime(end_date,"%Y/%m/%d %H:%M:%S")
    start_timpstamp = time.mktime(start_time)
    end_timestamp = time.mktime(end_time)
    runtime = (end_timestamp - start_timpstamp)/60
    return runtime


def get_startdate_and_runtime_info(file_path1,file_path2):
    start_date_pattern = re.compile(r"\[info \d{4}/\d{1,2}/\d{1,2} \d{1,2}:\d{1,2}:\d{1,2}")
    run_time_pattern = re.compile(r"\[OVERALL\]\, RunTime\(ms\)\, (\d+)")

    if not os.path.exists(file_path1) or not os.path.exists(file_path2) :
        print("File does not exist.")
        return None

    start_date = None
    total_runtime_min = 0
    file1=find_files_with_keyword(file_path1, "mixed")
    file2=find_files_with_keyword(file_path2, "mixed")
    ########get start Date in file1########
    if file1 is not None and len(file1) > 0:
        file = open(file_path1+'/'+file1, "r")
        for line in file.readlines():
            match = re.match(start_date_pattern, line)
            if match:
                start_date = match.group().replace("[info ","")
                break
        file.close()
    else:
        print("No mixed workload results found.")
        return None
    end_date = None
    
    ########get start Date and runtime in file2########
    if file2 is not None and len(file2) > 0:
        file = open(file_path2+'/'+file2, "r")
        for line in file.readlines():
            match = re.match(start_date_pattern, line)
            if match:
                end_date = match.group().replace("[info ","")
            else:
                match = re.match(run_time_pattern, line)
                if match:
                    total_runtime_min += int(match.group().split(",")[-1])/1000/60
                    break
        file.close()
    else:
        print("No mixed workload results found.")
        return None

    if end_date is None or start_date is None:
        print("Please check the mixed workload to see if the workload is complete.")
        return None
    total_runtime_min += caculate_runtime(start_date,end_date)

    return start_date,total_runtime_min

def get_avg_eachround_result(results_dir,keyword):
    avg_result = 0
    results = []
    ten_results = []
    i=0
    file = find_files_with_keyword(results_dir,"mixedalliterations"+keyword)
    if file is not None and len(file) > 0:
        file = open(results_dir+'/'+file, "r")
        for line in file.readlines():
           avg_result += float(line)
           results.append(float(line))
           i+=1
           if (i%10 ==0):
                ten_results.append(avg_result/i)
        file.close()
        avg_result = avg_result/i
        
    return avg_result,results,ten_results


