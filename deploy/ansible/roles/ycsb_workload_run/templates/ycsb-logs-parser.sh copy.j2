#!/bin/sh
## This script is to parse all the logs generated by Workload Script, consolidate & print the generated output

usage="USAGE $0 ResultsDirectory Iterations"

if [ $# -ne 2 ]; then
        echo $usage
        exit 1
fi

## Assign Key properties from Input Parameters to local variables
dest_dir=$1
no_of_iterations=$2
root_dir="/root/ycsb_benchmarks/results/"

## Cleanup temp files
{% set gf_server_list = groups['gemfire_server'] | map('extract', hostvars, 'ansible_host') | list %}
{% for gf_server in gf_server_list %}
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsruntimevalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsthroughputvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsrlatencyvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsr99latencyvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsulatencyvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationsu99latencyvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationscpugemfirevalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationspowerpreserver{{ gf_server }}.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationspowerpeakserver{{ gf_server }}.txt
rm -rf /root/ycsb_benchmarks/results/mixedalliterationspoweraverageserver{{ gf_server }}.txt
rm -rf /root/ycsb_benchmarks/results/mixedcpuvalues.txt
rm -rf /root/ycsb_benchmarks/results/mixedpowerpreserver{{ gf_server }}.txt
rm -rf /root/ycsb_benchmarks/results/mixedpowerpeakserver{{ gf_server }}.txt
rm -rf /root/ycsb_benchmarks/results/mixedpoweraverageserver{{ gf_server }}.txt
{% endfor %}


i=1

while [ $i -le $no_of_iterations ];
do
      target_dir=$dest_dir$i
      cd $target_dir

      ## Remove temp file
      rm -rf cpu-mpstat-fileslist.log

      ## Parse Logs if there are NO ERRORS found in any of the logs for the current iteration
      {% if ycsb_logs_parser_skiptimeout == true %}

      if [ `grep "ERROR" * | wc -l` -eq 0 ]
      {% elif ycsb_logs_parser_skiptimeout == false %}

      if [ `grep "ERROR" * | wc -l` -eq 0 ] && [ `grep "Exception" * | wc -l` -eq 0 ]
      {%endif%}
      then
            {% if metrics_enable %}
            
            #--------------------------------------no metrics or skip timeout------------------------------
            ## Identify the "pre-execution" log for Power Consumption Metric
            echo "****power-consumption"
            ls -lrth *power_consumption_pre* | awk '{ print $9 }' > /root/ycsb_benchmarks/results/power-consumption-pre-fileslist.log

            while read f; do
                  {% for gf_server in gf_server_list %}
                  if [ `echo $f | grep -c "server{{gf_server}}" ` -gt 0 ]
                  then
                        mixedpowerpreserver{{ gf_server }}=`cat $f | sed 's/Watts//g'`
                        echo ${mixedpowerpreserver{{ gf_server }}} > /root/ycsb_benchmarks/results/mixedpowerpreserver{{gf_server}}.txt
                        echo ${mixedpowerpreserver{{ gf_server }}} >> /root/ycsb_benchmarks/results/mixedalliterationspowerpreserver{{gf_server}}.txt
                  fi
                  {% endfor %}
            done < /root/ycsb_benchmarks/results/power-consumption-pre-fileslist.log

            ## Identify the "during-execution" log for Power Consumption Metric
            ls -lrth *power_consumption_during* | awk '{ print $9 }' > /root/ycsb_benchmarks/results/power-consumption-during-fileslist.log
            
            ## Compute the Power Utilization
            while read f; do
                  {% for gf_server in gf_server_list %}
                  if [ `echo $f | grep -c "server{{ gf_server }}" ` -gt 0 ]
                  then
                        cat $f | sed 's/Watts//g' > /root/ycsb_benchmarks/results/mixedpoweraverageserver{{ gf_server }}.txt
                        mixedpowerduringserver{{ gf_server }}=$(awk '{ sum += $1 } END { printf "%.0f", sum/NR }' /root/ycsb_benchmarks/results/mixedpoweraverageserver{{ gf_server }}.txt)
                        echo ${mixedpowerduringserver{{ gf_server }}} >> /root/ycsb_benchmarks/results/mixedalliterationspoweraverageserver{{ gf_server }}.txt
                  fi
                  {% endfor %}
            done < /root/ycsb_benchmarks/results/power-consumption-during-fileslist.log

            ## Identify the "during-execution" log for CPU Utilization Metric
            ls -lrth *mpstat* | awk '{ print $9 }' > /root/ycsb_benchmarks/results/cpu-mpstat-fileslist.txt
            #---------------------------------------end no metrics or skip timeout---------------------------------
            

            ## Remove temp file
            rm -rf /root/ycsb_benchmarks/results/mixedcpuvalues.txt
            #--------------------------------------no metrics or skip timeout------------------------------
            ## Compute the CPU Utilization
            while read f; do

                 mixedcpugemfire=`cat $f`
                 mixedcpugemfire=$((100 - mixedcpugemfire))
                 echo $mixedcpugemfire >> /root/ycsb_benchmarks/results/mixedcpuvalues.txt
            
            done < /root/ycsb_benchmarks/results/cpu-mpstat-fileslist.txt
            #--------------------------------------no metrics or skip timeout------------------------------
            {% endif %}

            echo "Results of Iteration $i"
            ### Parsing MIXED Workload Values###

            grep RunTime mixed* | awk '{print $3}' > /root/ycsb_benchmarks/results/mixedruntimevalues.txt
            grep Throughput mixed* | awk '{print $3}' > /root/ycsb_benchmarks/results/mixedthroughputvalues.txt
            grep AverageLatency mixed* | grep "READ" | awk '{print $3}'> /root/ycsb_benchmarks/results/mixedrlatencyvalues.txt
            grep 99thPercentileLatency mixed* | grep "READ" | awk '{print $3}'> /root/ycsb_benchmarks/results/mixedr99latencyvalues.txt
            grep AverageLatency mixed* | grep "UPDATE" | awk '{print $3}'> /root/ycsb_benchmarks/results/mixedulatencyvalues.txt
            grep 99thPercentileLatency mixed* | grep "UPDATE" | awk '{print $3}'> /root/ycsb_benchmarks/results/mixedu99latencyvalues.txt

            mixedruntime=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedruntimevalues.txt)
            mixedthroughput=$(awk '{ sum += $1 } END { printf "%.2f", sum }' /root/ycsb_benchmarks/results/mixedthroughputvalues.txt)
            mixedrlatency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedrlatencyvalues.txt)
            mixedr99latency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedr99latencyvalues.txt)
            mixedulatency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedulatencyvalues.txt)
            mixedu99latency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedu99latencyvalues.txt)

            {% if metrics_enable %}

            #--------------------------------------no metrics or skip timeout------------------------------
            mixedcpu=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedcpuvalues.txt)
            #--------------------------------------no metrics or skip timeout------------------------------
            {% endif %}

            mixedruntime=`echo "scale=2;($mixedruntime / 1000) / 60" | bc`
            mixedthroughput=`printf "%.0f" $mixedthroughput`
            mixedrlatency=`printf "%.0f" $mixedrlatency`
            mixedr99latency=`printf "%.0f" $mixedr99latency`
            mixedulatency=`printf "%.0f" $mixedulatency`
            mixedu99latency=`printf "%.0f" $mixedu99latency`

            {% if metrics_enable == false %}

            ## Print the Output based on the below static format
            #--------------------------------------no metrics or skip timeout------------------------------
            format="%10s%10s%14s%20s%20s%20s%20s%15s%20s%20s\n"
            printf "$format" "Workload" "RunTime" "Throughput" "ReadAvgLatency" "Read99thLatency" "UpdateAvgLatency" "Update99thLatency"   
            printf "$format" "MIXED" ${mixedruntime} ${mixedthroughput%.*} ${mixedrlatency%.*} ${mixedr99latency%.*} ${mixedulatency%.*} ${mixedu99latency%.*}   
            #--------------------------------------no metrics or skip timeout------------------------------
            {% endif %}
            
            {% if metrics_enable %}

            #--------------------------------------all------------------------------
            #format="%10s%10s%14s%20s%20s%20s%20s%15s%20s%20s\n"
            #printf "$format" "Workload" "RunTime" "Throughput" "ReadAvgLatency" "Read99thLatency" "UpdateAvgLatency" "Update99thLatency" "CPUAverage" "server1-Power-Idle" "server1-Power-Load" 
            #printf "$format" "MIXED" ${mixedruntime} ${mixedthroughput%.*} ${mixedrlatency%.*} ${mixedr99latency%.*} ${mixedulatency%.*} ${mixedu99latency%.*} ${mixedcpu%.*} ${mixedpowerpreserver1%.*} ${mixedpowerduringserver1%.*}
            format="%10s%10s%14s%20s%20s%20s%20s%15s%20s%20s\n"
            printf "$format" "Workload" "RunTime" "Throughput" "ReadAvgLatency" "Read99thLatency" "UpdateAvgLatency" "Update99thLatency" "CPUAverage" 
            printf "$format" "MIXED" ${mixedruntime} ${mixedthroughput%.*} ${mixedrlatency%.*} ${mixedr99latency%.*} ${mixedulatency%.*} ${mixedu99latency%.*} ${mixedcpu%.*}
            #--------------------------------------all------------------------------
            {% endif %}

            echo $mixedruntime >> /root/ycsb_benchmarks/results/mixedalliterationsruntimevalues.txt
            echo $mixedthroughput >> /root/ycsb_benchmarks/results/mixedalliterationsthroughputvalues.txt
            echo $mixedrlatency >> /root/ycsb_benchmarks/results/mixedalliterationsrlatencyvalues.txt
            echo $mixedr99latency >> /root/ycsb_benchmarks/results/mixedalliterationsr99latencyvalues.txt
            echo $mixedulatency >> /root/ycsb_benchmarks/results/mixedalliterationsulatencyvalues.txt
            echo $mixedu99latency >> /root/ycsb_benchmarks/results/mixedalliterationsu99latencyvalues.txt

            {% if metrics_enable %}

            #--------------------------------------all------------------------------
            echo $mixedcpu >> /root/ycsb_benchmarks/results/mixedalliterationscpugemfirevalues.txt
            #--------------------------------------all------------------------------
            {% endif %}
            ### End of Parsing MIXED Workload Values###

      ## If there are ERRORS found in any of the logs for the current iteration, print the below INVALID message with iteration number during which the error has occured
      else
            format="\n%50s\n"
            printf "$format" "INVALID RESULT FOR ITERATION $i, CHECK LOGS"
      fi

      printf '\n'

      i=$(( $i + 1 ))

done;


## Print CONSOLIDATED REULTS from ALL THE ITERATIONS - COMBINED AVERAGE

printf "\n\n"
echo "                                             RESULTS OF ALL $2 ITERATIONS - COMBINED AVERAGE                                                      "

mixedruntime=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsruntimevalues.txt)
mixedthroughput=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsthroughputvalues.txt)
mixedrlatency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsrlatencyvalues.txt)
mixedr99latency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsr99latencyvalues.txt)
mixedulatency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsulatencyvalues.txt)
mixedu99latency=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationsu99latencyvalues.txt)

{% if metrics_enable %}
#--------------------------------------all------------------------------
mixedcpu=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationscpugemfirevalues.txt)
{% for gf_server in gf_server_list %}
mixedpowerpreserver{{ gf_server }}=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationspowerpreserver{{ gf_server }}.txt)
mixedpowerduringserver{{ gf_server }}=$(awk '{ sum += $1 } END { printf "%.2f", sum/NR }' /root/ycsb_benchmarks/results/mixedalliterationspoweraverageserver{{ gf_server }}.txt)
#--------------------------------------all------------------------------
{% endfor %}
{% endif %}

{% if metrics_enable == false %}
#--------------------------------------no metrics or skip timeout------------------------------
format="%10s%10s%14s%20s%20s%20s%20s%15s%20s%20s\n"
printf "$format" "Workload" "RunTime" "Throughput" "ReadAvgLatency" "Read99thLatency" "UpdateAvgLatency" "Update99thLatency"  
printf "$format" "MIXED" ${mixedruntime} ${mixedthroughput%.*} ${mixedrlatency%.*} ${mixedr99latency%.*} ${mixedulatency%.*} ${mixedu99latency%.*}
#--------------------------------------no metrics or skip timeout------------------------------
{% endif %}

{% if metrics_enable %}
#--------------------------------------all------------------------------
format="%10s%10s%14s%20s%20s%20s%20s%15s%20s%20s\n"
printf "$format" "Workload" "RunTime" "Throughput" "ReadAvgLatency" "Read99thLatency" "UpdateAvgLatency" "Update99thLatency" "CPUAverage" "server1-Power-Idle" "server1-Power-Load" 
printf "$format" "MIXED" ${mixedruntime} ${mixedthroughput%.*} ${mixedrlatency%.*} ${mixedr99latency%.*} ${mixedulatency%.*} ${mixedu99latency%.*} ${mixedcpu%.*} ${mixedpowerpreserver{{ gf_server_list[0] }}%.*} ${mixedpowerduringserver{{ gf_server_list[0] }}%.*} 
#--------------------------------------all------------------------------
{% endif %}
exit
