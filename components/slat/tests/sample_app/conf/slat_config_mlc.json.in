{
  "slat": {
    "logic_lib_dir": "@PATH_TO_LOGIC_LIB@",
    "logger": {
      "log_level": "INFO",
      "log_file_name": "/var/log/svk/slat.log",
      "log_file_count": 1,
      "log_file_size": 1048576,
      "sink_type": "rotating_file"
    },
    "benchmark_run_interval" : 10,
    "disable_bg_thread" : "false"
  }
}