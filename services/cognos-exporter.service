[Unit]
Description=Cognos Exporter
After=influxdb.service network.target
PartOf=cognos.service

[Service]
SyslogIdentifier=Cognos Exporter
WorkingDirectory=/usr/local/svk/svkapp
KillMode=control-group
Restart=on-failure
ExecStart=/bin/bash -c "/usr/local/svk/svkapp/sapp/scripts/exporter-start.sh"
ExecReload = /bin/kill -s HUP $MAINPID
ExecStop = /bin/kill -s SIGKILL $MAINPID
SuccessExitStatus=SIGKILL

[Install]
WantedBy=multi-user.target