#!/usr/bin/make -f

# We can get a version string if needed
INSTALL_PATH = usr/local/svk/feature_modules/slat

%:
	dh $@

override_dh_auto_configure:
	# Configure steps below (eg: cmake)
	cmake -DWITH_RELEASE=ON -DPKG_CONFIG_PREFIX=/$(INSTALL_PATH) -DCMAKE_INSTALL_PREFIX=/$(INSTALL_PATH) ..

override_dh_auto_build:
	# build steps below (eg: make)
	make -j$(nproc)

override_dh_auto_install:
	# install steps below (eg: make install)
	make install DESTDIR=$(CURDIR)
	mkdir -p $(INSTALL_PATH)

override_dh_usrlocal:
	# Do nothing, because we are installing to /usr/local even though this is non-standard practice

override_dh_install:
	# Create ld.conf.so.d file if needed
	mkdir --verbose --parent $(CURDIR)/etc/ld.so.conf.d
	echo "/$(INSTALL_PATH)/lib64" > $(CURDIR)/etc/ld.so.conf.d/svk-slat.conf

	dh_install

override_dh_strip:
	# Do not generate debug symbol packages
	dh_strip --no-ddebs

override_dh_shlibdeps:
	# Set link path for shlibdeps if needed
	dh_shlibdeps -l$(CURDIR)/$(INSTALL_PATH)/lib64

override_dh_installsystemd:
	# If we are installing a service
	# dh_installsystemd

