#!/bin/dash

# install python deps
python3 -m venv /usr/local/svk/svk-app/env
. /usr/local/svk/svk-app/env/bin/activate
python3 -m pip install -r /usr/local/svk/svk-app/requirements.txt

# import scmc conf to Caddy
CADDYFILE=/etc/caddy/Caddyfile
IMPORT_LINE='import /etc/caddy/Caddyfile.d/*'

if [ ! -f "$CADDYFILE" ]; then
    echo "$IMPORT_LINE" > "$CADDYFILE"
else
    if ! grep -qF "$IMPORT_LINE" "$CADDYFILE"; then
        echo "" >> "$CADDYFILE"
        echo "$IMPORT_LINE" >> "$CADDYFILE"
    fi
fi

# update permissions of compiled ui code
chown -R caddy:caddy /var/www/scmc
chmod -R a+rX /var/www/scmc
