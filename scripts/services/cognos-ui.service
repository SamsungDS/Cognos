[Unit]
Description=Cognos UI Service
After=network.target

[Service]
SyslogIdentifier=Cognos UI Service
WorkingDirectory=/usr/local/svk/svk-app/cognos/ui
KillMode=control-group
Restart=on-failure
ExecStart=npm start
ExecReload = /bin/kill -s HUP $MAINPID
ExecStop = /bin/kill -s TERM $MAINPID

[Install]
WantedBy=multi-user.target