"""
amoprof/report/combined.py — Merge the executive, interactive, and static reports
into a single HTML file with iframe-isolated tabs.

  Tab 1: 🧭 Executive    (high-level summary, default)
  Tab 2: ⚡ Interactive  (Plotly hover charts)
  Tab 3: 📊 Static       (full amoprof matplotlib PNG report)

The child reports are embedded via <iframe srcdoc> so each report keeps its own
CSS/JS without leaking styles into the others.  The executive tab is generated
from the raw run directory and is intentionally small, fast, and readable.
"""
from __future__ import annotations

import csv
import html as _html
import json
import math
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple


# ─── Utilities ──────────────────────────────────────────────────────────────

def _safe_float(v: Any, default: float = 0.0) -> float:
    try:
        if v is None or v == "":
            return default
        x = float(v)
        if math.isnan(x) or math.isinf(x):
            return default
        return x
    except Exception:
        return default


def _fmt_num(v: Any, unit: str = "", digits: int = 1, na: str = "N/A") -> str:
    x = _safe_float(v, None)  # type: ignore[arg-type]
    if x is None:
        return na
    if abs(x) >= 1000 and unit not in ("%", "x"):
        s = f"{x:,.{digits}f}"
    else:
        s = f"{x:.{digits}f}"
    if digits == 0:
        s = s.split(".")[0]
    return f"{s}{unit}"


def _read_json(path: Path) -> Dict[str, Any]:
    try:
        if path.exists() and path.stat().st_size > 0:
            with path.open("r", encoding="utf-8", errors="replace") as f:
                obj = json.load(f)
            return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}
    return {}


def _first_existing(raw_dir: Path, names: Iterable[str]) -> Optional[Path]:
    for n in names:
        p = raw_dir / n
        if p.exists() and p.stat().st_size > 0:
            return p
    return None


def _read_csv_summary(path: Optional[Path], max_rows: int = 20000) -> Dict[str, Any]:
    """Return simple aggregate stats for numeric columns without pandas."""
    if not path or not path.exists() or path.stat().st_size == 0:
        return {"rows": 0, "columns": []}
    stats: Dict[str, Dict[str, float]] = {}
    rows = 0
    cols: List[str] = []
    first: Dict[str, str] = {}
    last: Dict[str, str] = {}
    try:
        with path.open("r", encoding="utf-8", errors="replace", newline="") as f:
            r = csv.DictReader(f)
            cols = list(r.fieldnames or [])
            for row in r:
                rows += 1
                if rows == 1:
                    first = dict(row)
                last = dict(row)
                for k, v in row.items():
                    x = _safe_float(v, None)  # type: ignore[arg-type]
                    if x is None:
                        continue
                    d = stats.setdefault(k, {"count": 0.0, "sum": 0.0, "max": -1e300, "min": 1e300})
                    d["count"] += 1.0
                    d["sum"] += x
                    d["max"] = max(d["max"], x)
                    d["min"] = min(d["min"], x)
                if rows >= max_rows:
                    break
    except Exception:
        return {"rows": rows, "columns": cols, "error": "parse_failed"}
    out: Dict[str, Any] = {"rows": rows, "columns": cols, "first": first, "last": last}
    for k, d in stats.items():
        if d["count"] > 0:
            out[k] = {
                "mean": d["sum"] / d["count"],
                "max": d["max"],
                "min": d["min"],
                "count": d["count"],
            }
    return out


def _pick(d: Dict[str, Any], keys: Iterable[str], default: Any = None) -> Any:
    for k in keys:
        if k in d and d[k] not in (None, "", "unknown", "Unknown"):
            return d[k]
    # also try case-insensitive exact match for setup_details.json
    lower = {str(k).lower(): v for k, v in d.items()}
    for k in keys:
        lk = str(k).lower()
        if lk in lower and lower[lk] not in (None, "", "unknown", "Unknown"):
            return lower[lk]
    return default


def _status(label: str, ok: bool, detail: str = "") -> str:
    cls = "ok" if ok else "warn"
    icon = "✓" if ok else "!"
    return f'<span class="pill {cls}">{icon} {_html.escape(label)}</span>' + (f'<span class="muted"> {_html.escape(detail)}</span>' if detail else "")


# ─── Executive summary generation ──────────────────────────────────────────

def build_executive_summary_html(raw_dir: Path, run_label: str = "") -> str:
    raw_dir = Path(raw_dir)
    setup = _read_json(raw_dir / "setup_details.json")
    sglang = _read_json(raw_dir / "sglang_summary.json")
    gpu = _read_json(raw_dir / "gpu_summary.json")
    blk = _read_json(raw_dir / "summary.json")

    # Optional compact CSV summaries.  These are intentionally small reads.
    sglang_ts = _read_csv_summary(_first_existing(raw_dir, ["sglang_timeseries.csv"]))
    gpu_ts = _read_csv_summary(_first_existing(raw_dir, ["gpu_timeseries.csv"]))
    nvme_ts = _read_csv_summary(_first_existing(raw_dir, ["nvme_driver_timeseries.csv", "iostat_timeseries.csv"]))
    vmstat_ts = _read_csv_summary(_first_existing(raw_dir, ["vmstat_timeseries.csv"]))
    dram_ts = _read_csv_summary(_first_existing(raw_dir, ["amduprof_pcm_timeseries.csv", "pcm_timeseries.csv"]))

    model = _pick(setup, ["Model", "model", "model_name", "Model path", "model_path"], None)
    if not model:
        model = _pick(sglang, ["model_name", "model", "model_path"], "unknown")
    instance = _pick(setup, ["Instance", "instance", "Server", "server"], _pick(sglang, ["instance"], "unknown"))
    runtime = _pick(setup, ["Runtime", "runtime", "Server runtime"], _pick(sglang, ["server_type", "runtime"], "SGLang"))
    gpu_desc = _pick(setup, ["GPU", "gpu", "Accelerator"], "unknown")
    launch = _pick(setup, ["Launch command", "launch_command", "Command"], "")

    ttft_ms = _pick(sglang, ["ttft_ms", "avg_ttft_ms", "mean_ttft_ms", "time_to_first_token_ms", "server_ttft_p50_ms"], 0.0)
    tpot_ms = _pick(sglang, ["tpot_ms", "avg_tpot_ms", "mean_tpot_ms", "itl_ms", "server_itl_p50_ms"], 0.0)
    e2e_ms = _pick(sglang, ["e2e_ms", "avg_latency_ms", "latency_ms", "server_e2e_p50_ms"], 0.0)
    cache_hit = _pick(sglang, ["cache_hit_pct", "cache_hit_rate_pct", "cache_hit_active_avg_pct", "cache_hit"], 0.0)
    throughput = _pick(sglang, ["ai_op_decode_tok_s", "gen_tp_active_mean", "gen_tp_mean", "throughput_tok_s", "peak_throughput_tok_s"], None)
    if throughput is None and "gen_throughput" in sglang_ts:
        throughput = sglang_ts["gen_throughput"].get("mean", 0.0)

    gpu_util = _pick(gpu, ["gpu_util_mean", "gpu_util_pct_mean", "util_mean"], None)
    if gpu_util is None and "gpu_util" in gpu_ts:
        gpu_util = gpu_ts["gpu_util"].get("mean", 0.0)
    hbm_gb = _pick(gpu, ["hbm_used_gb_mean", "hbm_gb", "mem_used_gb_mean"], None)
    hbm_pct = _pick(gpu, ["hbm_util_pct_mean", "hbm_pct", "mem_util_pct_mean"], None)

    read_gb = _pick(blk, ["read_gb_total", "read_GB_total"], None)
    if read_gb is None:
        read_gb = _safe_float(_pick(blk, ["read_bytes_total"], 0.0)) / (1024**3)
    write_gb = _pick(blk, ["write_gb_total", "write_GB_total"], None)
    if write_gb is None:
        write_gb = _safe_float(_pick(blk, ["write_bytes_total"], 0.0)) / (1024**3)
    nvme_rd_bw = _pick(blk, ["read_bw_mb_s_mean"], None)
    if nvme_rd_bw is None:
        for col in ("rd_bw_mbs", "read_bw_mbs", "rkB_s"):
            if col in nvme_ts:
                nvme_rd_bw = nvme_ts[col].get("mean", 0.0)
                if col == "rkB_s":
                    nvme_rd_bw = _safe_float(nvme_rd_bw) / 1024.0
                break
    nvme_wr_bw = _pick(blk, ["write_bw_mb_s_mean"], None)
    if nvme_wr_bw is None:
        for col in ("wr_bw_mbs", "write_bw_mbs", "wkB_s"):
            if col in nvme_ts:
                nvme_wr_bw = nvme_ts[col].get("mean", 0.0)
                if col == "wkB_s":
                    nvme_wr_bw = _safe_float(nvme_wr_bw) / 1024.0
                break

    dram_bw = None
    for col in ("dram_bw_gbps", "total_bw_gbps", "memory_bw_gbps", "Total GB/s"):
        if col in dram_ts:
            dram_bw = dram_ts[col].get("mean", 0.0)
            break

    has_sglang = bool(sglang) and (_safe_float(ttft_ms) > 0 or _safe_float(tpot_ms) > 0 or _safe_float(cache_hit) > 0)
    has_gpu = bool(gpu) or gpu_ts.get("rows", 0) > 0
    has_nvme = bool(blk) or nvme_ts.get("rows", 0) > 0
    has_dram = dram_ts.get("rows", 0) > 0
    has_vmstat = vmstat_ts.get("rows", 0) > 0

    findings: List[str] = []
    if _safe_float(cache_hit) > 0:
        if _safe_float(cache_hit) < 40:
            findings.append("Cache reuse appears low for the selected window; inspect prompt sharing, LPM scheduling, cache warmup, and HiCache L2/L3 movement.")
        elif _safe_float(cache_hit) >= 55:
            findings.append("Cache-hit gauge is strong in active windows; remaining latency is more likely from long-prefill compute, GPU/HBM pressure, queueing, or storage movement spikes.")
    if _safe_float(ttft_ms) > 30000:
        findings.append("TTFT is high; for long-context workloads, prioritize prefill compute, KV load-back, and queue-time separation.")
    if _safe_float(gpu_util) > 90:
        findings.append("GPU utilization is high; the run is likely compute/HBM-bound while active, not purely CPU or orchestration limited.")
    if _safe_float(read_gb) > 100:
        findings.append("SSD read volume is significant; correlate L3 read bursts with TTFT/P99 latency and cache load-back counters.")
    if not findings:
        findings.append("Only partial data was available for this window; review the data-source badges and rerun with SGLang/DCGM/blktrace/DRAM collectors enabled as needed.")

    setup_rows = [
        ("Model", model), ("Instance", instance), ("Runtime", runtime), ("GPU", gpu_desc),
        ("TP / DP", f"{_pick(setup, ['TP size','tp_size'], 'unknown')} / {_pick(setup, ['DP size','dp_size'], 'unknown')}"),
        ("Attention backend", _pick(setup, ["Attention backend", "attention_backend"], "unknown")),
        ("HiCache", _pick(setup, ["HiCache", "Hierarchical cache", "enable_hierarchical_cache"], "unknown")),
    ]

    def kpi(label: str, value: str, note: str = "") -> str:
        return f"""<div class=\"kpi\"><div class=\"kpi-label\">{_html.escape(label)}</div><div class=\"kpi-value\">{_html.escape(value)}</div><div class=\"kpi-note\">{_html.escape(note)}</div></div>"""

    setup_html = "".join(
        f"<tr><td>{_html.escape(str(k))}</td><td>{_html.escape(str(v))}</td></tr>"
        for k, v in setup_rows if str(v) not in ("", "None")
    )
    if launch:
        setup_html += f"<tr><td>Launch command</td><td><code>{_html.escape(str(launch))}</code></td></tr>"

    layer_rows = [
        ("A5 · Application / benchmark", "Cache hit, request mix, TTFT/E2E", "OK" if has_sglang else "Missing", "Use cache-hit methodology and percentile tabs for workload quality."),
        ("A4 · Runtime + model", "SGLang metrics, KV cache counters", "OK" if has_sglang else "Missing", "Check prefill/decode split and KV tier movement."),
        ("L1 · GPU/HBM", "DCGM util, memory, power", "OK" if has_gpu else "Missing", "High util with high HBM suggests compute/HBM pressure."),
        ("L2 · Host DRAM", "AMD EPYC PMU / vmstat", "OK" if has_dram or has_vmstat else "Partial/Missing", "Use DRAM bandwidth and page activity for L2 pressure."),
        ("L3 · NVMe SSD", "NVMe/iostat, blktrace, biosnoop", "OK" if has_nvme else "Missing", "Use request-size, IAT, hot-region, and R/W/T panels for SSD behavior."),
    ]
    layers_html = "".join(
        f"<tr><td>{_html.escape(a)}</td><td>{_html.escape(b)}</td><td><span class=\"state {'ok' if c == 'OK' else 'warn'}\">{_html.escape(c)}</span></td><td>{_html.escape(d)}</td></tr>"
        for a,b,c,d in layer_rows
    )

    findings_html = "".join(f"<li>{_html.escape(x)}</li>" for x in findings)
    data_badges = " · ".join([
        _status("SGLang", has_sglang), _status("GPU/DCGM", has_gpu),
        _status("DRAM/PMU", has_dram), _status("NVMe/SSD", has_nvme), _status("vmstat", has_vmstat),
    ])

    title_suffix = f" · {_html.escape(run_label)}" if run_label else ""
    return f"""<!DOCTYPE html>
<html lang=\"en\"><head><meta charset=\"utf-8\"/>
<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>
<title>AMOprof Executive Summary{title_suffix}</title>
<style>
  * {{ box-sizing: border-box; }}
  body {{ margin:0; padding:24px; background:#0f172a; color:#e2e8f0; font-family:Inter,system-ui,-apple-system,sans-serif; line-height:1.5; }}
  .wrap {{ max-width:1400px; margin:0 auto; }}
  .hero {{ background:linear-gradient(135deg,#1e293b,#0f172a); border:1px solid #334155; border-radius:16px; padding:22px 26px; margin-bottom:16px; }}
  h1 {{ margin:0 0 6px 0; font-size:26px; letter-spacing:-0.4px; }}
  h2 {{ font-size:16px; margin:0 0 12px 0; color:#f8fafc; }}
  .sub,.muted {{ color:#94a3b8; font-size:13px; }}
  .grid {{ display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin:16px 0; }}
  .kpi {{ background:#111827; border:1px solid #334155; border-radius:12px; padding:13px 14px; }}
  .kpi-label {{ color:#94a3b8; font-size:11px; text-transform:uppercase; letter-spacing:.6px; font-weight:700; }}
  .kpi-value {{ color:#f8fafc; font-size:22px; font-weight:800; margin-top:4px; }}
  .kpi-note {{ color:#64748b; font-size:11px; margin-top:3px; }}
  .card {{ background:#1e293b; border:1px solid #334155; border-radius:14px; padding:18px 20px; margin:14px 0; box-shadow:0 2px 8px rgba(0,0,0,.22); }}
  table {{ width:100%; border-collapse:collapse; font-size:13px; overflow:hidden; border-radius:10px; }}
  th {{ background:#0f172a; color:#cbd5e1; text-align:left; padding:10px 12px; border-bottom:1px solid #334155; }}
  td {{ padding:9px 12px; border-bottom:1px solid #334155; color:#e2e8f0; vertical-align:top; }}
  tr:nth-child(even) td {{ background:rgba(15,23,42,.35); }}
  code {{ color:#e0f2fe; background:#0f172a; border:1px solid #334155; border-radius:6px; padding:2px 5px; word-break:break-word; }}
  .pill {{ display:inline-block; border-radius:999px; padding:4px 9px; font-size:12px; font-weight:800; margin:2px 3px 2px 0; }}
  .pill.ok,.state.ok {{ background:#064e3b; color:#bbf7d0; border:1px solid #047857; }}
  .pill.warn,.state.warn {{ background:#78350f; color:#fde68a; border:1px solid #b45309; }}
  .state {{ display:inline-block; border-radius:999px; padding:3px 8px; font-size:11px; font-weight:800; }}
  ul {{ margin:0; padding-left:20px; }}
  li {{ margin:7px 0; }}
</style></head>
<body><div class=\"wrap\">
  <div class=\"hero\">
    <h1>🧭 Executive Summary</h1>
    <div class=\"sub\">AMOprof stack-layer diagnosis{title_suffix} · Model: <b>{_html.escape(str(model))}</b> · Instance: <b>{_html.escape(str(instance))}</b></div>
    <div style=\"margin-top:10px\">{data_badges}</div>
  </div>

  <div class=\"grid\">
    {kpi('Cache hit', _fmt_num(cache_hit, '%', 1), 'active gauge / report KPI')}
    {kpi('TTFT', _fmt_num(ttft_ms, ' ms', 0), 'time to first token')}
    {kpi('TPOT / ITL', _fmt_num(tpot_ms, ' ms', 1), 'decode token latency')}
    {kpi('E2E latency', _fmt_num(e2e_ms, ' ms', 0), 'request latency')}
    {kpi('Throughput', _fmt_num(throughput, ' tok/s', 1), 'active or detected mean')}
    {kpi('GPU util', _fmt_num(gpu_util, '%', 1), 'DCGM mean')}
    {kpi('HBM used', _fmt_num(hbm_gb, ' GB', 1) if hbm_gb is not None else _fmt_num(hbm_pct, '%', 1), 'GPU memory')}
    {kpi('SSD read / write', f'{_fmt_num(read_gb, " GB", 1)} / {_fmt_num(write_gb, " GB", 1)}', 'blktrace/NVMe')}
    {kpi('NVMe read BW', _fmt_num(nvme_rd_bw, ' MB/s', 1), 'mean')}
    {kpi('DRAM BW', _fmt_num(dram_bw, ' GB/s', 1), 'AMD PMU mean')}
  </div>

  <div class=\"card\"><h2>Top findings</h2><ul>{findings_html}</ul></div>
  <div class=\"card\"><h2>Setup / Server Configuration Snapshot</h2><table><tbody>{setup_html}</tbody></table></div>
  <div class=\"card\"><h2>Layered Stack Summary</h2><table><thead><tr><th>Layer</th><th>Evidence</th><th>Status</th><th>What to inspect next</th></tr></thead><tbody>{layers_html}</tbody></table></div>
  <div class=\"card\"><h2>How to use this combined report</h2><ul><li>Use this Executive tab for the quick answer and data-source health.</li><li>Use the Interactive tab for exact hover values and time-series correlation.</li><li>Use the Static tab for full formulas, bottleneck scorecards, and detailed PNG charts.</li></ul></div>
</div></body></html>"""


# ─── Tab-bar chrome (outer wrapper page only) ───────────────────────────────

_OUTER_CSS = """
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; background: #0f172a; font-family: 'Inter', system-ui, sans-serif; }
  #amoprof-tabbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 9999; height: 46px;
    display: flex; align-items: stretch; background: #0f172a; border-bottom: 2px solid #1e293b;
    box-shadow: 0 2px 12px rgba(0,0,0,0.5); padding: 0 12px;
  }
  .tab-logo { display:flex; align-items:center; gap:7px; color:#e2e8f0; font-size:13px; font-weight:700; padding:0 14px 0 2px; border-right:1px solid #334155; margin-right:6px; letter-spacing:-0.2px; white-space:nowrap; }
  .tab-logo span { color:#818cf8; }
  .tab-btn { display:flex; align-items:center; gap:6px; padding:0 18px; font-size:13px; font-weight:600; color:#94a3b8; background:transparent; border:none; border-bottom:3px solid transparent; cursor:pointer; white-space:nowrap; transition:color .15s,border-color .15s,background .15s; height:100%; }
  .tab-btn:hover { color:#e2e8f0; background:rgba(255,255,255,0.04); }
  .tab-btn.active { color:#a5b4fc; border-bottom-color:#6366f1; background:rgba(99,102,241,0.08); }
  .tab-badge { font-size:9.5px; font-weight:700; padding:2px 5px; border-radius:8px; background:#1e293b; color:#64748b; letter-spacing:.4px; }
  .tab-btn.active .tab-badge { background:#312e81; color:#a5b4fc; }
  .tab-spacer { flex:1; }
  .tab-hint { display:flex; align-items:center; font-size:10.5px; color:#475569; padding:0 8px; font-style:italic; }
  .tab-frame { position:fixed; top:46px; left:0; right:0; bottom:0; border:none; width:100%; height:calc(100vh - 46px); background:#fff; display:none; }
  .tab-frame.active { display:block; }
</style>
"""

_OUTER_JS = """
<script>
(function() {
  var TABS = ['executive', 'interactive', 'static'];
  var KEY  = 'amoprof_active_tab';
  var _staticLoaded = false;

  function showTab(id) {
    TABS.forEach(function(t) {
      var frame = document.getElementById('frame-' + t);
      var btn   = document.getElementById('btn-'   + t);
      if (!frame || !btn) return;
      if (t === id) {
        frame.classList.add('active'); btn.classList.add('active');
        if (t === 'static' && !_staticLoaded) {
          var src = frame.getAttribute('data-srcdoc');
          if (src) { frame.srcdoc = src; frame.removeAttribute('data-srcdoc'); }
          _staticLoaded = true;
        }
      } else { frame.classList.remove('active'); btn.classList.remove('active'); }
    });
    try { history.replaceState(null, '', '#' + id); } catch(e) {}
    try { localStorage.setItem(KEY, id); } catch(e) {}
  }

  window.amoprofShowTab = showTab;
  document.addEventListener('DOMContentLoaded', function() {
    var hash = (window.location.hash || '').replace('#', '');
    var stored = '';
    try { stored = localStorage.getItem(KEY) || ''; } catch(e) {}
    var initial = TABS.indexOf(hash) >= 0 ? hash : TABS.indexOf(stored) >= 0 ? stored : 'executive';
    showTab(initial);
  });
  document.addEventListener('keydown', function(e) {
    if (!e.altKey) return;
    if (e.key === '1') { amoprofShowTab('executive');   e.preventDefault(); }
    if (e.key === '2') { amoprofShowTab('interactive'); e.preventDefault(); }
    if (e.key === '3') { amoprofShowTab('static');      e.preventDefault(); }
  });
})();
</script>
"""


def merge_reports(
    static_html: str,
    interactive_html: str,
    executive_html: str = "",
    run_label: str = "",
    title: str = "AMOprof Combined Report",
) -> str:
    """Return a combined HTML string with executive, interactive, and static tabs."""
    label_suffix = f" — {run_label}" if run_label else ""
    page_title = f"{title}{label_suffix}"

    def _srcdoc(html_str: str) -> str:
        return html_str.replace('&', '&amp;').replace('"', '&quot;')

    exe_srcdoc = _srcdoc(executive_html or "<html><body><h1>Executive Summary unavailable</h1></body></html>")
    int_srcdoc = _srcdoc(interactive_html)
    sta_srcdoc = _srcdoc(static_html)

    return f"""<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"utf-8\"/>
  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>
  <title>{_html.escape(page_title)}</title>
  {_OUTER_CSS}
</head>
<body>
<div id=\"amoprof-tabbar\" role=\"tablist\">
  <div class=\"tab-logo\">📊 <span>AMO</span>prof</div>
  <button id=\"btn-executive\" class=\"tab-btn\" role=\"tab\" onclick=\"amoprofShowTab('executive')\" title=\"Executive summary — quick findings and data-source health\">🧭 Executive<span class=\"tab-badge\">SUMMARY</span></button>
  <button id=\"btn-interactive\" class=\"tab-btn\" role=\"tab\" onclick=\"amoprofShowTab('interactive')\" title=\"Interactive Plotly charts — hover for exact values\">⚡ Interactive<span class=\"tab-badge\">PLOTLY</span></button>
  <button id=\"btn-static\" class=\"tab-btn\" role=\"tab\" onclick=\"amoprofShowTab('static')\" title=\"Full static report — matplotlib PNGs, bottleneck table, formulas\">📊 Static<span class=\"tab-badge\">PNG</span></button>
  <div class=\"tab-spacer\"></div>
  <div class=\"tab-hint\">⌨ Alt+1 / Alt+2 / Alt+3</div>
</div>
<iframe id=\"frame-executive\" class=\"tab-frame\" srcdoc=\"{exe_srcdoc}\" title=\"Executive Summary\"></iframe>
<iframe id=\"frame-interactive\" class=\"tab-frame\" srcdoc=\"{int_srcdoc}\" title=\"Interactive Report\"></iframe>
<iframe id=\"frame-static\" class=\"tab-frame\" data-srcdoc=\"{sta_srcdoc}\" title=\"Static Report\"></iframe>
{_OUTER_JS}
</body>
</html>"""


# ─── Entry point ─────────────────────────────────────────────────────────────

def build_combined_report(
    raw_dir: Path,
    out_html: Path,
    static_html_path: "Path | None" = None,
    interactive_html_path: "Path | None" = None,
    run_label: str = "",
    theme: str = "dark",
) -> Path:
    """Generate a combined tabbed HTML report."""
    import logging
    log = logging.getLogger("amoprof.combined")
    raw_dir = Path(raw_dir)
    out_html = Path(out_html)
    out_html.parent.mkdir(parents=True, exist_ok=True)

    if static_html_path and Path(static_html_path).exists():
        static_html = Path(static_html_path).read_text(encoding='utf-8', errors='replace')
        log.info("combined: loaded static report from %s (%d KB)", static_html_path, len(static_html) // 1024)
    else:
        import sys, subprocess
        tmp = out_html.parent / "_tmp_static.html"
        try:
            import importlib.util as _ilu
            spec = _ilu.spec_from_file_location('amoprof_report', Path(__file__).parent / 'amoprof.py')
            _mod = _ilu.module_from_spec(spec)
            spec.loader.exec_module(_mod)  # type: ignore[union-attr]
            _mod.main(argv=[str(raw_dir), '--output', str(tmp)])
        except Exception as e:
            log.warning("combined: static report inline gen failed (%s) — subprocess", e)
            subprocess.run([sys.executable, str(Path(__file__).parent / 'amoprof.py'), str(raw_dir), '--output', str(tmp)], check=True)
        try:
            from .enhancer import enhance_report
            enhance_report(tmp, raw_dir=raw_dir, theme=theme)
        except Exception as e:
            log.warning("combined: enhancer failed (%s)", e)
        static_html = tmp.read_text(encoding='utf-8', errors='replace')
        try: tmp.unlink()
        except OSError: pass
        log.info("combined: generated static report (%d KB)", len(static_html) // 1024)

    if interactive_html_path and Path(interactive_html_path).exists():
        interactive_html = Path(interactive_html_path).read_text(encoding='utf-8', errors='replace')
        log.info("combined: loaded interactive report from %s (%d KB)", interactive_html_path, len(interactive_html) // 1024)
    else:
        from .interactive import build_report as _build_int
        tmp = out_html.parent / "_tmp_interactive.html"
        _build_int(raw_dir, tmp, run_label=run_label)
        interactive_html = tmp.read_text(encoding='utf-8', errors='replace')
        try: tmp.unlink()
        except OSError: pass
        log.info("combined: generated interactive report (%d KB)", len(interactive_html) // 1024)

    try:
        executive_html = build_executive_summary_html(raw_dir, run_label=run_label)
        log.info("combined: generated executive summary (%d KB)", len(executive_html) // 1024)
    except Exception as e:
        log.warning("combined: executive summary generation failed: %s", e)
        executive_html = "<html><body><h1>Executive Summary unavailable</h1><p>See Interactive and Static tabs.</p></body></html>"

    combined = merge_reports(static_html, interactive_html, executive_html=executive_html, run_label=run_label)
    out_html.write_text(combined, encoding='utf-8')
    log.info("combined: wrote %s (%d KB)", out_html, len(combined) // 1024)
    return out_html
